{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dauffrey/cohervia/schemas/capability-transfer-assessment.schema.json",
  "title": "CapabilityTransferConfigurationAssessment",
  "description": "Configuration × task-family-stratum capability-transfer assessment produced from Holdout B by the frozen transfer evaluator. Confirmed labels are discrete-gate constrained; downstream selectors must independently recompute numeric transfer gates from the recorded values.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "assessment_id",
    "experiment_id",
    "configuration_id",
    "timestamp",
    "system_configuration_hash",
    "transfer_holdout_manifest_hash",
    "transfer_evaluator_hash",
    "transfer_estimator_hash",
    "comparator_definition_hash",
    "task_family_id",
    "capability_endpoint_id",
    "n_target_trials",
    "n_comparator_trials",
    "baseline_prediction",
    "mean_observed_value",
    "delta_transfer",
    "transfer_delta_min",
    "lower_confidence_bound",
    "uncertainty_procedure_hash",
    "multiplicity_rule_hash",
    "multiplicity_result",
    "verifier_result",
    "protocol_valid",
    "transfer_classification",
    "supporting_trial_observation_ids",
    "supporting_comparator_observation_ids",
    "provenance_hash"
  ],
  "properties": {
    "record_type": {
      "const": "configuration_transfer_assessment"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^COH-EXP-[0-9]{4}$"
    },
    "configuration_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "system_configuration_hash": {
      "type": "string",
      "minLength": 1
    },
    "transfer_holdout_manifest_hash": {
      "type": "string",
      "minLength": 1
    },
    "transfer_evaluator_hash": {
      "type": "string",
      "minLength": 1
    },
    "transfer_estimator_hash": {
      "type": "string",
      "minLength": 1
    },
    "comparator_definition_hash": {
      "type": "string",
      "minLength": 1
    },
    "task_family_id": {
      "type": "string",
      "minLength": 1
    },
    "capability_endpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "n_target_trials": {
      "type": "integer",
      "minimum": 1
    },
    "n_comparator_trials": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_prediction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "mean_observed_value": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "delta_transfer": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "transfer_delta_min": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lower_confidence_bound": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "uncertainty_procedure_hash": {
      "type": "string",
      "minLength": 1
    },
    "multiplicity_rule_hash": {
      "type": "string",
      "minLength": 1
    },
    "multiplicity_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "not_applicable"
      ]
    },
    "verifier_result": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "indeterminate"
      ]
    },
    "protocol_valid": {
      "type": "boolean"
    },
    "transfer_classification": {
      "type": "string",
      "enum": [
        "confirmed",
        "not_confirmed",
        "invalid"
      ]
    },
    "supporting_trial_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "supporting_comparator_observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "provenance_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "transfer_classification": {
            "const": "confirmed"
          }
        },
        "required": [
          "transfer_classification"
        ]
      },
      "then": {
        "properties": {
          "protocol_valid": {
            "const": true
          },
          "verifier_result": {
            "const": "pass"
          },
          "multiplicity_result": {
            "enum": [
              "pass",
              "not_applicable"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "transfer_classification": {
            "const": "invalid"
          }
        },
        "required": [
          "transfer_classification"
        ]
      },
      "then": {
        "properties": {
          "protocol_valid": {
            "const": false
          }
        }
      }
    }
  ]
}
